# Copy this file to server/.env and fill in your key. server/.env is gitignored.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for composition (blueprint + parts). Override here to upgrade without touching code.
MODEL=claude-opus-4-8

# Cheaper model used for search and the ground-truth lookup — formatting/retrieval, not composition.
RETRIEVAL_MODEL=claude-sonnet-5

# Port the Express proxy listens on (Vite dev proxy forwards /api here).
PORT=3001

# Origin CORS is locked to. Set this to your deployed frontend's URL in production
# (e.g. https://myapp.vercel.app) — leaving the default only works for local dev.
FRONTEND_ORIGIN=http://localhost:5173
